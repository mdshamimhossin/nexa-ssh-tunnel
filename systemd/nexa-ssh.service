[Unit]
Description=Nexa SSH TLS CONNECT Proxy
After=network-online.target ssh.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/nexa-ssh/proxy.env
ExecStart=/usr/bin/python3 /opt/nexa-ssh/proxy.py
Restart=on-failure
RestartSec=3
User=root
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/nexa-ssh
PrivateTmp=true

[Install]
WantedBy=multi-user.target
